{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMIS 0.4.0 capability descriptor",
  "type": "object",
  "properties": {
    "format": {
      "const": "amis.capabilities"
    },
    "version": {
      "const": "0.4.0"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": true
    },
    "protocol_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "items": {
              "enum": [
                "describe",
                "scan",
                "normalize",
                "plan",
                "apply",
                "verify"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "coordination": {
            "type": "array",
            "items": {
              "enum": [
                "versioned_api",
                "cooperative_lock",
                "quiescent_required"
              ]
            },
            "uniqueItems": true
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "version",
          "operations",
          "scopes",
          "kinds",
          "coordination",
          "verification"
        ],
        "additionalProperties": true
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_document_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_records": {
          "type": "integer",
          "minimum": 1
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_source_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_source_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_document_bytes",
        "max_records",
        "max_depth",
        "max_source_bytes",
        "max_total_source_bytes"
      ],
      "additionalProperties": true
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "required": [
    "format",
    "version",
    "provider",
    "implementation",
    "protocol_versions",
    "features",
    "profiles",
    "limits",
    "configuration_digest",
    "observed_at",
    "expires_at",
    "integrity"
  ],
  "additionalProperties": true,
  "$defs": {
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "jcs-rfc8785"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
