{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMIS \u2014 Agent Memory Interface Spec \u2014 0.4.0 bundle",
  "description": "Shape contract. Canonical integrity, references, scopes and publication semantics require the behavioral validation in SPEC.md.",
  "type": "object",
  "properties": {
    "format": {
      "const": "amis.bundle"
    },
    "version": {
      "const": "0.4.0"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "exported_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": true
    },
    "required_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "allOf": [
        {
          "contains": {
            "const": "amis.scope.v1"
          }
        },
        {
          "contains": {
            "const": "amis.revision-graph.v1"
          }
        },
        {
          "contains": {
            "const": "amis.integrity.jcs-sha256.v1"
          }
        }
      ]
    },
    "history": {
      "type": "object",
      "properties": {
        "coverage": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "missing_parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision_ref"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "coverage",
        "missing_parents"
      ],
      "additionalProperties": true
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "extensions": {
      "type": "object"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "required": [
    "format",
    "version",
    "bundle_id",
    "exported_at",
    "producer",
    "required_features",
    "history",
    "records",
    "snapshots",
    "integrity"
  ],
  "additionalProperties": true,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "object",
          "properties": {
            "format": {
              "enum": [
                "text/plain",
                "text/markdown"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "format",
            "text"
          ],
          "additionalProperties": true
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "status": {
          "enum": [
            "active",
            "withdrawn"
          ]
        },
        "validity": {
          "type": "object",
          "properties": {
            "not_before": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "required": [
            "not_before",
            "expires_at"
          ],
          "additionalProperties": true
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "derivation": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "verbatim",
                "parsed",
                "human_edited",
                "model_proposed",
                "authored"
              ]
            },
            "adapter": {
              "type": "string",
              "minLength": 1
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/revision_ref"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "adapter",
            "inputs"
          ],
          "additionalProperties": true
        },
        "withdrawal": {
          "type": "object",
          "properties": {
            "reason": {
              "enum": [
                "user_request",
                "obsolete",
                "merged",
                "other"
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": true
        },
        "extensions": {
          "type": "object"
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        },
        "format": {
          "const": "amis.record"
        },
        "version": {
          "const": "0.4.0"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "completeness": {
              "enum": [
                "complete",
                "partial",
                "unknown"
              ]
            },
            "omissions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reason": {
                    "enum": [
                      "not_recorded",
                      "withheld",
                      "erased",
                      "unavailable"
                    ]
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "reason",
                  "detail"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "completeness",
            "omissions"
          ],
          "additionalProperties": true
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "created_at",
        "title",
        "kind",
        "scope",
        "status",
        "validity",
        "sources",
        "derivation",
        "integrity",
        "format",
        "version",
        "provenance"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          },
          "then": {
            "required": [
              "body"
            ]
          },
          "else": {
            "required": [
              "withdrawal"
            ],
            "properties": {
              "revision": {
                "properties": {
                  "parents": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "revision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision_ref"
          },
          "uniqueItems": true
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "parents",
        "created_at"
      ],
      "additionalProperties": true
    },
    "revision_ref": {
      "type": "object",
      "properties": {
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "memory_id",
        "revision_id",
        "digest"
      ],
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "source_created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "native_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "selector": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "utf8-byte-range"
            },
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "start",
            "length"
          ],
          "additionalProperties": true
        },
        "provider": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "provider",
        "locator",
        "snapshot_ref",
        "observed_at",
        "source_created_at",
        "native_kind"
      ],
      "additionalProperties": true
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "base64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*$"
        },
        "availability": {
          "enum": [
            "included",
            "withheld",
            "erased",
            "unavailable"
          ]
        }
      },
      "required": [
        "sha256",
        "byte_length",
        "media_type",
        "availability"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "included"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "text"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "base64"
                      ]
                    },
                    {
                      "required": [
                        "path"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "base64"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "text"
                      ]
                    },
                    {
                      "required": [
                        "path"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "path"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "text"
                      ]
                    },
                    {
                      "required": [
                        "base64"
                      ]
                    }
                  ]
                }
              }
            ],
            "properties": {
              "byte_length": {
                "type": "integer"
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "base64"
                  ]
                },
                {
                  "required": [
                    "path"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unknown"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "global"
            },
            "subject_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "subject_ref"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "project"
            },
            "project_ref": {
              "type": "string",
              "minLength": 1,
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "kind",
            "project_ref"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "path"
            },
            "project_ref": {
              "type": "string",
              "minLength": 1,
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "matching": {
              "enum": [
                "exact",
                "subtree"
              ]
            }
          },
          "required": [
            "kind",
            "project_ref",
            "paths",
            "matching"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "agent"
            },
            "project_ref": {
              "type": "string",
              "minLength": 1,
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "agent_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "project_ref",
            "agent_ref"
          ],
          "additionalProperties": true
        }
      ]
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "jcs-rfc8785"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "digest"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "oneOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/revision_ref"
                },
                {
                  "not": {
                    "required": [
                      "selection"
                    ]
                  }
                }
              ]
            },
            {
              "type": "object",
              "properties": {
                "memory_id": {
                  "type": "string",
                  "minLength": 1,
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "selection": {
                  "const": "current"
                }
              },
              "required": [
                "memory_id",
                "selection"
              ],
              "additionalProperties": true,
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "revision_id"
                    ]
                  },
                  {
                    "required": [
                      "digest"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "relation",
        "target"
      ],
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "records": {
            "contains": {
              "required": [
                "links"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "required_features": {
            "contains": {
              "const": "amis.links.v1"
            }
          }
        }
      }
    }
  ]
}
